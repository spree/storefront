{
  "name": "nextjs-starter-spree",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "predev": "node scripts/ensure-local-sdk.mjs",
    "prebuild": "node scripts/ensure-local-sdk.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:locales": "tsx scripts/check-locale-parity.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:merch": "playwright test -c playwright.merchandising.config.ts",
    "test:e2e:buyer-desktop": "playwright test -c playwright.beta-isolated.config.ts",
    "e2e:merch:localhost:bootstrap": "node ./scripts/e2e/bootstrap-merchandising-localhost.mjs",
    "e2e:up": "docker compose -f e2e-backend/docker-compose.yml up -d --wait && ./scripts/e2e/bootstrap-spree.sh",
    "e2e:merch:up": "docker compose -f e2e-backend/docker-compose.merchandising.yml up -d --wait && bash ./scripts/e2e/bootstrap-merchandising.sh",
    "e2e:merch:down": "docker compose -f e2e-backend/docker-compose.merchandising.yml down -v",
    "e2e:down": "docker compose -f e2e-backend/docker-compose.yml down -v"
  },
  "dependencies": {
    "@adyen/adyen-web": "^6.33.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@next/third-parties": "16.4.5",
    "@paypal/react-paypal-js": "^9.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.78.0",
    "@spree/sdk": "file:../packages/sdk",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@swc/helpers": "^0.5.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.1",
    "liquidjs": "10.29.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-email": "^6.1.4",
    "react-svg-credit-card-payment-icons": "^5.1.2",
    "resend": "^6.9.4",
    "sanitize-html": "^2.18.0",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "postcss": "^8.5.10",
    "mute-stream": "^3.0.0",
    "sharp": "0.35.5",
    "@hono/node-server": "2.1.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.3",
      "brace-expansion": "5.0.12",
      "browserslist": "^4.28.9",
      "fast-uri": "3.1.9",
      "hono": "4.13.11",
      "ip-address": "10.7.4",
      "js-yaml": "^4.3.2",
      "minimatch": "^10.2.1",
      "mute-stream": "^3.0.0",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.28",
      "qs": "6.16.1",
      "shadcn>postcss-selector-parser": "^7.1.6",
      "sharp": "0.35.5",
      "socket.io-parser": "^4.2.7",
      "undici": "7.30.1",
      "body-parser": "2.4.0",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "engine.io": "6.6.10",
      "@modelcontextprotocol/sdk": "1.32.0",
      "baseline-browser-mapping": "2.11.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "lefthook"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "^1.60.0",
    "@spree/cli": "^3.1.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.0.0",
    "lefthook": "^2.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
