{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-theme-recovery-current/types/**/*.ts",
    ".next-theme-recovery-current/dev/types/**/*.ts",
    ".next-cms-e2e/types/**/*.ts",
    ".next-cms-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules.broken-082630",
    "e2e",
    "_header_rebuilt.tsx",
    "playwright.config.ts",
    "playwright.*.config.ts"
  ]
}
